{
  "name": "e-commerce-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "overrides": {
    "eslint": {
      "ajv": "6.15.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:db": "npm run db:deploy:test && NODE_ENV=test node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:fast": "npm run test:unit && npm run test:api && npm run test:web",
    "test:e2e:smoke": "playwright test tests/e2e/foundation.spec.ts",
    "test:e2e:acceptance": "node --env-file=.env --import tsx scripts/verify-e2e-env.ts && node --env-file=.env node_modules/@playwright/test/cli.js test tests/e2e/critical.spec.ts tests/e2e/responsive.spec.ts",
    "test:e2e": "npm run test:e2e:acceptance",
    "test:all": "npm run test:fast && npm run test:db && npm run test:e2e:acceptance",
    "test": "npm run test:all",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:test": "node --env-file=.env --import tsx scripts/deploy-test-database.ts",
    "provision:admin": "tsx apps/api/src/auth/provision-admin.ts",
    "cleanup:expired": "tsx apps/api/src/maintenance/cleanup-expired.ts",
    "build": "npm run prisma:generate && npm run build --workspace=@ecommerce/contracts && npm run build --workspace=@ecommerce/api && npm run build --workspace=@ecommerce/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
