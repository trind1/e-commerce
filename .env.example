NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ecommerce:change-me@127.0.0.1:5432/ecommerce?schema=public
TEST_DATABASE_URL=postgresql://ecommerce:change-me@127.0.0.1:5432/ecommerce_test?schema=public
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=10
# Used by compose.yaml only. Keep this aligned with both database URLs above.
POSTGRES_PASSWORD=change-me
SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
# Prefer the same-origin API proxy in local/production web deployments.
VITE_API_URL=/api

# One-shot Admin provisioning: persist only a SHA-256 digest in .env. Never put the raw token here.
# Generate it with: node -e "const c=require('node:crypto'); console.log(c.createHash('sha256').update(process.argv[1]).digest('hex'))" "your-token"
ADMIN_PROVISION_TOKEN_HASH=replace-with-a-64-character-sha256-hex-digest
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-local-only-password
ADMIN_DISPLAY_NAME=Administrator

# Optional: completed checkout idempotency keys are retained forever unless this explicit policy is set.
# CHECKOUT_IDEMPOTENCY_RETENTION_SECONDS=2592000

# API-backed Playwright acceptance environment. It must target a disposable _test database.
# E2E_DATABASE_URL=postgresql://ecommerce:change-me@127.0.0.1:5432/ecommerce_test?schema=public
# E2E_SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=replace-with-a-test-only-password
